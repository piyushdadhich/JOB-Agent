venv/
venv-skills/
__pycache__/
*.pyc
*.pyo
.env

# Third-party tools cloned locally for reference / optional use.
# Spec H1-fix TASK 1 clones theHarvester here; its 25+ heavy deps
# (playwright, lxml, censys, shodan, ...) make a full install
# infeasible — kept as a reference copy only.
vendor/

# Per-profile sqlite databases (one per profile under data/{id}/).
data/*/tracker.db
data/*/tracker.db-journal

# Assembled extraction prompt; regenerated each run, not source-controlled.
data/*/.last_extraction_prompt.txt

# Legacy data locations from earlier phases.
data/tracker.db
data/opportunities/*.json
data/applications/*
data/exploration/*.json
data/hidden_market/*.json

output/
logs/
*.log

credentials.json
token.json

.DS_Store
.obsidian/

# Local Claude Code state (settings.local.json, scheduled_tasks.lock).
.claude/settings.local.json
.claude/scheduled_tasks.lock
# Note: .claude/modes/ is intentionally NOT ignored — modular skill
# docs (Spec JA-1 TASK 3) live there.

# Profile-specific config that may contain PII; keep local.
source_materials/*/user_profile.yaml
source_materials/*/domain_profile.yaml

# PII-heavy session handover docs stay local.
Job_Agent_Handover*.md
# Exception: structural/architectural handover docs under docs/handover/
# are NOT PII-heavy and DO belong in the repo. Spec 7 TASK 4 (May 2026).
!docs/handover/Job_Agent_Handover*.md

# Cloud evaluator (Gemma 4 31B via Google AI Studio).
# Per-profile under data/{profile}/.
data/*/gemini_api_key.txt
data/*/cloud_eval_usage.jsonl
data/*/cloud_eval_queue.json

# Gmail API OAuth credentials + refresh token.
data/*/gmail_credentials.json
data/*/gmail_token.json

# Playwright Application Agent (Phase 11).
# Applicant profile holds PII; QA cache holds proposed answers we
# may not want in the repo; pending docx + screenshots are runtime
# artifacts.
config/profiles/*_applicant.yaml
config/applicant_qa_cache.json
data/*/applications/pending/
data/*/applications/screenshots/

# === Spec 3 TASK 2 tightening ===

# Test + frontend build caches.
.pytest_cache/
node_modules/

# Build output (regenerated by `npm run build`).
dashboard/frontend/dist/

# Loose-match safety nets (databases + envs anywhere).
*.db
*.db-journal
.env.local

# Pre-migration DB backups (e.g. tracker.db.pre_v2_11_backup).
*.pre_v*_backup

# Generated run artifacts: daily logs, eval reports, shortlists.
scripts/output/

# Per-profile generated data (PII; regenerated by pipeline runs).
data/*/gap_reports/
data/*/resumes/
data/*/inventory_extract.json
data/*/inventory_history/
data/*/inventory_summary*.md

# Per-profile source materials (PII: real name + contact + history).
source_materials/*/career_inventory.md
source_materials/*/proof_points.md
source_materials/*/resumes/

# Editable-install metadata (Spec 16 — created by `pip install -e .`).
*.egg-info/
build/
dist/

# Live profile YAML — onboarding writes; only .example tracked.
config/profiles/default.yaml

# Live domain vocabulary — wizard generates; only .example tracked.
config/domains/corporate.yaml
